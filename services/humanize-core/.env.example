# All keys are read by humanize_core/config.py (Settings). Values below are the
# code defaults unless marked otherwise.

# --- Provider -------------------------------------------------------------
# stub | openai | anthropic | openrouter
# Only openrouter runs the full graph (rewrite + style gate + model audit +
# model review). openai/anthropic run rewrite only; the rest is local rules.
HUMANIZE_MODEL_PROVIDER=stub
HUMANIZE_MODEL_NAME=stub

# provider=openai (Responses API, strict JSON schema)
# HUMANIZE_MODEL_PROVIDER=openai
# HUMANIZE_MODEL_NAME=<openai-model>
# OPENAI_API_KEY=<secret>

# provider=anthropic (Messages API, JSON in text)
# HUMANIZE_MODEL_PROVIDER=anthropic
# HUMANIZE_MODEL_NAME=<anthropic-model>
# ANTHROPIC_API_KEY=<secret>

# provider=openrouter (production path)
# HUMANIZE_MODEL_PROVIDER=openrouter
# OPENROUTER_API_KEY=<secret>
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_APP_TITLE=Dadeum Humanize Core
# OPENROUTER_SITE_URL=
# HUMANIZE_MODEL_NAME overrides the rewrite primary when set to anything but "stub".
# HUMANIZE_REWRITE_MODEL_NAME=anthropic/claude-sonnet-5.5
# HUMANIZE_REWRITE_FALLBACK_MODEL_NAME=anthropic/claude-haiku-5.5
# HUMANIZE_STRICT_AUDIT_MODEL_NAME=anthropic/claude-haiku-5.5
# HUMANIZE_STRICT_REVIEW_MODEL_NAME=anthropic/claude-haiku-5.5
# Optional: model that writes the user-facing change reasons and summary in
# finalize. Falls back to the rewrite primary when unset.
# HUMANIZE_EXPLAIN_MODEL_NAME=anthropic/claude-sonnet-5.5
# Eval judge for scripts/eval_golden.py --judge (not used by the service).
# HUMANIZE_EVAL_JUDGE_MODEL_NAME=anthropic/claude-sonnet-5.5

# --- Server-to-server auth ------------------------------------------------
# Both must be set; empty values reject every request with 401.
HUMANIZE_CORE_API_KEY=<shared-core-api-key>
HUMANIZE_CORE_SIGNING_SECRET=<shared-hmac-secret>

# --- Limits and pipeline tuning ------------------------------------------
HUMANIZE_MAX_CHARS=5000
# HUMANIZE_CHUNK_MIN_CHARS=1000
# HUMANIZE_CHUNK_TARGET_CHARS=1000
# HUMANIZE_STYLE_GATE_MAX_ROUNDS=2
# HUMANIZE_STYLE_GATE_S2_THRESHOLD=3

# --- Strict job store / worker -------------------------------------------
# docker-compose.yml overrides the store path to /data/humanize_jobs.sqlite3.
# HUMANIZE_JOB_STORE_PATH=humanize_jobs.sqlite3
# 32-byte hex or base64url. Falls back to sha256(HUMANIZE_CORE_SIGNING_SECRET).
# HUMANIZE_JOB_ENCRYPTION_KEY=
# HUMANIZE_JOB_WORKER_ENABLED=true
# HUMANIZE_JOB_POLL_INTERVAL_SECONDS=1.0
# HUMANIZE_JOB_LOCK_SECONDS=600
# HUMANIZE_JOB_RETENTION_SECONDS=86400
# HUMANIZE_JOB_MAX_ATTEMPTS=2

# --- Debug logs (daily files YYYY-MM-DD.log) ------------------------------
HUMANIZE_DEBUG_LOG_ENABLED=true
# Production .env uses /data/humanize-core/logs (the compose volume).
HUMANIZE_DEBUG_LOG_DIR=~/.dadeum/humanize-core/logs
# Enable temporarily when debugging needs source/rewrite/change text in logs.
HUMANIZE_DEBUG_LOG_INCLUDE_PLAINTEXT=false
